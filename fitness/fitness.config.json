{
  "tsconfig": "tsconfig.json",
  "exclude": ["test/**", "**/*.test.ts"],
  "kinds": {
    "rules": { "match": "src/model/rules/**", "dependsOn": ["model"] },
    "model": { "match": "src/model/**", "dependsOn": [] },
    "app": { "match": "src/app/**", "dependsOn": ["model"] },
    "reporter": { "match": "src/reporters/**", "dependsOn": ["model"] },
    "adapter": { "match": ["src/analysis/**", "src/config/**", "src/git/**"], "dependsOn": ["app", "model"] },
    "entry": { "match": ["src/cli.ts", "src/builtins.ts"], "dependsOn": ["adapter", "reporter", "app", "model", "rules"] },
    "api": { "match": "src/index.ts", "dependsOn": ["model"], "rules": { "no-cross-kind-reexport": { "allow": ["model"] } } },
    "integration": { "match": "integrations/**", "dependsOn": [] }
  }
}
