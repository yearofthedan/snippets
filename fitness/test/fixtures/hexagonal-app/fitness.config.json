{
  "rules": {
    "module-cohesion": { "maxLines": 15 },
    "function-cohesion": { "maxLines": 6 },
    "cognitive-complexity": { "max": 4 }
  },
  "kinds": {
    "domain": { "match": "src/domain/**", "dependsOn": [] },
    "app": { "match": "src/app/**", "dependsOn": ["domain"] },
    "adapter": { "match": "src/adapters/**", "dependsOn": ["domain", "app"] }
  }
}
