{
  "name": "fitness",
  "version": "0.1.0",
  "private": true,
  "description": "Architectural fitness checks for TypeScript codebases",
  "type": "module",
  "bin": {
    "fitness": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'",
    "fitness": "node src/cli.ts"
  },
  "dependencies": {
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "^22.18.0"
  },
  "packageManager": "pnpm@10.28.0"
}
